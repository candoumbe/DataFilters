{
  "name": "datafilters",
  "version": "0.1.0",
  "description": "Generate filter expressions compatible with the DataFilters C# library",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/**/*.ts test/**/*.ts",
    "test": "jest",
    "test:cov": "jest --coverage",
    "prepublishOnly": "npm run lint && npm run build && npm test"
  },
  "keywords": [
    "filters",
    "query",
    "elasticsearch",
    "datafilters"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0"
  }
}
